# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/movie_bot

# Redis connection string
REDIS_URL=redis://redis:6379/0

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# Private storage channel ID (negative number, e.g. -1001234567890)
STORAGE_CHANNEL_ID=-1001234567890

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Environment: development, production
ENVIRONMENT=production

# --- Webhook mode (set USE_WEBHOOK=true on Railway) ---
# Set to true to run via webhook instead of long polling.
USE_WEBHOOK=false

# Public webhook URL, e.g. https://your-app.up.railway.app/webhook/bot
WEBHOOK_URL=

# Path Telegram posts updates to (must match the URL path above).
WEBHOOK_PATH=/webhook/bot

# Host/port the webhook server binds to.
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# Railway/Heroku inject a PORT env var automatically. If set, it overrides
# WEBHOOK_PORT so the platform proxy can reach the app. No need to set manually.
# PORT=8080

# Optional secret token (recommended). Telegram sends it in
# X-Telegram-Bot-Api-Secret-Token header.
WEBHOOK_SECRET=